# Скопируйте в .env и заполните локально. Файл .env в git не попадает.

# --- Backend (Go) ---
# HTTP-адрес API
UCRP_HTTP_ADDR=:8080
# SQLite на старте; при переходе на PostgreSQL меняется только DSN и драйвер
UCRP_DATABASE_URL=sqlite://./data/ucrp.db
# Секрет подписи JWT (сгенерируйте свой: openssl rand -hex 32)
UCRP_JWT_SECRET=change-me
# Каталог для загруженных файлов импорта
UCRP_UPLOAD_DIR=./uploads
# Уровень логирования: debug | info | warn | error
UCRP_LOG_LEVEL=info

# --- Frontend (Vite) ---
# Базовый URL API; в dev удобнее проксировать через vite server.proxy
VITE_API_BASE_URL=http://localhost:8080/api/v1
