{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app", "@/app/*"],
                "message": "FSD: слой shared не может импортировать app"
              },
              {
                "group": ["@/pages", "@/pages/*"],
                "message": "FSD: слой shared не может импортировать pages"
              },
              {
                "group": ["@/features", "@/features/*"],
                "message": "FSD: слой shared не может импортировать features"
              },
              {
                "group": ["@/entities", "@/entities/*"],
                "message": "FSD: слой shared не может импортировать entities"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/entities/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app", "@/app/*"],
                "message": "FSD: слой entities не может импортировать app"
              },
              {
                "group": ["@/pages", "@/pages/*"],
                "message": "FSD: слой entities не может импортировать pages"
              },
              {
                "group": ["@/features", "@/features/*"],
                "message": "FSD: слой entities не может импортировать features"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app", "@/app/*"],
                "message": "FSD: слой features не может импортировать app"
              },
              {
                "group": ["@/pages", "@/pages/*"],
                "message": "FSD: слой features не может импортировать pages"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/pages/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app", "@/app/*"],
                "message": "FSD: слой pages не может импортировать app"
              }
            ]
          }
        ]
      }
    }
  ]
}
