{
    "paths":  {
                  "/api/v1/auth/login":  {
                                             "post":  {
                                                          "tags":  [
                                                                       "Auth"
                                                                   ],
                                                          "operationId":  "loginUser",
                                                          "summary":  "Вход по email и паролю",
                                                          "description":  "Проверяет хэш пароля и активность учётной записи. Одинаковый ответ 401 на неверный email и неверный пароль не раскрывает существование пользователя. Access-токен живёт 15 минут и содержит claims `sub`, `role`, `tenantId` (для R-3). Refresh-токен передаётся в httpOnly cookie.",
                                                          "security":  [

                                                                       ],
                                                          "x-roles":  [
                                                                          "pub"
                                                                      ],
                                                          "x-uc":  [
                                                                       "UC-16"
                                                                   ],
                                                          "requestBody":  {
                                                                              "required":  true,
                                                                              "content":  {
                                                                                              "application/json":  {
                                                                                                                       "schema":  {
                                                                                                                                      "$ref": "../components/schemas/users.json#/LoginRequest"
                                                                                                                                  }
                                                                                                                   }
                                                                                          }
                                                                          },
                                                          "responses":  {
                                                                            "200":  {
                                                                                        "description":  "Успешный вход",
                                                                                        "headers":  {
                                                                                                        "Set-Cookie":  {
                                                                                                                           "description":  "refresh-токен, httpOnly, Secure, SameSite=Strict, Path=/api/v1/auth",
                                                                                                                           "schema":  {
                                                                                                                                          "type":  "string"
                                                                                                                                      }
                                                                                                                       }
                                                                                                    },
                                                                                        "content":  {
                                                                                                        "application/json":  {
                                                                                                                                 "schema":  {
                                                                                                                                                "$ref": "../components/schemas/users.json#/LoginResponse"
                                                                                                                                            }
                                                                                                                             }
                                                                                                    }
                                                                                    },
                                                                            "400":  {
                                                                                        "$ref": "../components/responses.json#/BadRequest"
                                                                                    },
                                                                            "401":  {
                                                                                        "$ref": "../components/responses.json#/Unauthorized"
                                                                                    },
                                                                            "429":  {
                                                                                        "$ref": "../components/responses.json#/TooManyRequests"
                                                                                    }
                                                                        }
                                                      }
                                         },
                  "/api/v1/auth/refresh":  {
                                               "post":  {
                                                            "tags":  [
                                                                         "Auth"
                                                                     ],
                                                            "operationId":  "refreshToken",
                                                            "summary":  "Обновление access-токена по refresh-cookie",
                                                            "description":  "Читает refresh-токен из httpOnly cookie. Просроченный или отозванный токен → 401, клиент переходит на экран входа. SPA выполняет обновление single-flight.",
                                                            "security":  [
                                                                             {
                                                                                 "cookieAuth":  [

                                                                                                ]
                                                                             }
                                                                         ],
                                                            "x-roles":  [
                                                                            "pub"
                                                                        ],
                                                            "x-uc":  [
                                                                         "UC-16"
                                                                     ],
                                                            "responses":  {
                                                                              "200":  {
                                                                                          "description":  "Новый access-токен",
                                                                                          "content":  {
                                                                                                          "application/json":  {
                                                                                                                                   "schema":  {
                                                                                                                                                  "$ref": "../components/schemas/users.json#/TokenResponse"
                                                                                                                                              }
                                                                                                                               }
                                                                                                      }
                                                                                      },
                                                                              "401":  {
                                                                                          "$ref": "../components/responses.json#/Unauthorized"
                                                                                      }
                                                                          }
                                                        }
                                           },
                  "/api/v1/auth/logout":  {
                                              "post":  {
                                                           "tags":  [
                                                                        "Auth"
                                                                    ],
                                                           "operationId":  "logoutUser",
                                                           "summary":  "Отзыв refresh-токена",
                                                           "description":  "Отзывает текущий refresh-токен и очищает cookie. Access-токен доживает до истечения TTL.",
                                                           "x-roles":  [
                                                                           "any"
                                                                       ],
                                                           "x-uc":  [
                                                                        "UC-16"
                                                                    ],
                                                           "responses":  {
                                                                             "204":  {
                                                                                         "$ref": "../components/responses.json#/NoContent"
                                                                                     },
                                                                             "401":  {
                                                                                         "$ref": "../components/responses.json#/Unauthorized"
                                                                                     }
                                                                         }
                                                       }
                                          },
                  "/api/v1/auth/me":  {
                                          "get":  {
                                                      "tags":  [
                                                                   "Auth"
                                                               ],
                                                      "operationId":  "getCurrentUser",
                                                      "summary":  "Профиль, роль и tenantId текущего пользователя",
                                                      "description":  "Используется SPA для построения меню по роли. Для R-3 возвращает `tenantId` из claims — единственный источник арендатора для последующих проверок.",
                                                      "x-roles":  [
                                                                      "any"
                                                                  ],
                                                      "x-uc":  [
                                                                   "UC-16",
                                                                   "UC-8"
                                                               ],
                                                      "responses":  {
                                                                        "200":  {
                                                                                    "description":  "Текущий пользователь",
                                                                                    "content":  {
                                                                                                    "application/json":  {
                                                                                                                             "schema":  {
                                                                                                                                            "$ref": "../components/schemas/users.json#/MeResponse"
                                                                                                                                        }
                                                                                                                         }
                                                                                                }
                                                                                },
                                                                        "401":  {
                                                                                    "$ref": "../components/responses.json#/Unauthorized"
                                                                                }
                                                                    }
                                                  }
                                      }
              }
}