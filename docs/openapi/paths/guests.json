                                                                     "R-1",
                                                                     "R-4"
                                                                 ],
                                                     "x-uc":  [
                                                                  "UC-2"
                                                              ],
                                                     "parameters":  [
                                                                        {
                                                                            "name":  "q",
                                                                            "in":  "query",
                                                                            "required":  true,
                                                                            "description":  "Phone, email, card, or name",
                                                                            "schema":  {
                                                                                           "type":  "string",
                                                                                           "minLength":  2,
                                                                                           "maxLength":  200
                                                                                       }
                                                                        },
                                                                        {
                                                                            "$ref": "../components/parameters.json#/Page"
                                                                        },
                                                                        {
                                                                            "$ref": "../components/parameters.json#/PageSize"
                                                                        }
                                                                    ],
                                                     "responses":  {
                                                                       "200":  {
                                                                                   "description":  "Search result page",
                                                                                   "content":  {
                                                                                                   "application/json":  {
                                                                                                                            "schema":  {
                                                                                                                                           "$ref": "../components/schemas/guests.json#/GuestPage"
                                                                                                                                       }
                                                                                                                        }
                                                                                               }
                                                                               },
                                                                       "400":  {
                                                                                   "$ref": "../components/responses.json#/BadRequest"
                                                                               },
                                                                       "401":  {
                                                                                   "$ref": "../components/responses.json#/Unauthorized"
                                                                               },
                                                                       "403":  {
                                                                                   "$ref": "../components/responses.json#/Forbidden"
                                                                               }
                                                                   }
                                                 }
                                     },
