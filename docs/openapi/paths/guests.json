                                                                                        "$ref": "../components/responses.json#/NotFound"
                                                                                    }
                                                                        }
                                                      },
                                              "delete":  {
                                                             "tags":  [
                                                                          "Guests"
                                                                      ],
                                                             "operationId":  "deleteGuest",
                                                             "summary":  "Soft-delete a guest",
                                                             "description":  "Sets `status=deleted` and `deletedAt`. There is no hard delete: events and identifiers are preserved for reversibility and audit.",
                                                             "x-roles":  [
                                                                             "R-4"
