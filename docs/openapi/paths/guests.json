{
  "paths": {
    "/api/v1/guests": {
      "get": {
        "tags": ["Guests"],
        "operationId": "searchGuests",
        "summary": "Search guests",
        "description": "Lists and searches guests. All filters are optional and combined with AND; `q` is no longer mandatory when any filter is given, and an empty request lists all guests. Filters `period_from`/`period_to` select guests with activity in the period (both bounds inclusive). Search by phone, email, card, or name. The input is normalized with the same rules as during import, so `+7 900 123-45-67` and `89001234567` find the same guest. Merged profiles (`status=merged`) are excluded from results.",
        "x-roles": ["R-1", "R-4"],
        "x-uc": ["UC-2"],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Phone, email, card, or name. Optional: not required when any other filter is given; a request with no `q` and no filters lists all guests. When provided, must be 2 to 200 characters.",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 200
            }
          },
          {
            "name": "source_id",
            "in": "query",
            "required": false,
            "description": "Only guests that have events from this data source.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "tenant_id",
            "in": "query",
            "required": false,
            "description": "Only guests that have events at this tenant.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "period_from",
            "in": "query",
            "required": false,
            "description": "Start of the activity period, inclusive. Only guests with activity on or after this date.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "period_to",
            "in": "query",
            "required": false,
            "description": "End of the activity period, inclusive. Only guests with activity on or before this date.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "$ref": "../components/parameters.json#/Page"
          },
          {
            "$ref": "../components/parameters.json#/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Search result page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../components/schemas/guests.json#/GuestPage"
                }
              }
            }
          },
          "400": {
            "$ref": "../components/responses.json#/BadRequest"
          },
          "401": {
            "$ref": "../components/responses.json#/Unauthorized"
          },
          "403": {
            "$ref": "../components/responses.json#/Forbidden"
          }
        }
      }
    },
    "/api/v1/guests/{id}": {
      "parameters": [
        {
          "$ref": "../components/parameters.json#/IdPath"
        }
      ],
      "get": {
        "tags": ["Guests"],
        "operationId": "getGuest",
        "summary": "Unified guest profile",
        "description": "Returns a unified profile for management users. A tenant with a guest.profile.read grant receives a tenant-scoped profile only when its own event exists within the permitted period; identifiers require separate grants and are limited to the tenant’s data sources. The global display name and cross-tenant details are not returned.",
        "x-roles": ["R-1", "R-2", "R-3 (with grant)", "R-4"],
        "x-uc": ["UC-2"],
        "responses": {
          "200": {
            "description": "Guest profile",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "$ref": "../components/schemas/guests.json#/GuestProfile" },
                    { "$ref": "../components/schemas/tenant-guest.json#/TenantGuestProfile" }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "../components/responses.json#/Unauthorized"
          },
          "403": {
            "$ref": "../components/responses.json#/Forbidden"
          },
          "404": {
            "$ref": "../components/responses.json#/NotFound"
          }
        }
      },
      "delete": {
        "tags": ["Guests"],
        "operationId": "deleteGuest",
        "summary": "Soft-delete a guest",
        "description": "Sets `status=deleted` and `deletedAt`. There is no hard delete: events and identifiers are preserved for reversibility and audit.",
        "x-roles": ["R-4"],
        "x-uc": ["UC-2"],
        "responses": {
          "204": {
            "$ref": "../components/responses.json#/NoContent"
          },
          "401": {
            "$ref": "../components/responses.json#/Unauthorized"
          },
          "403": {
            "$ref": "../components/responses.json#/Forbidden"
          },
          "404": {
            "$ref": "../components/responses.json#/NotFound"
          }
        }
      }
    },
    "/api/v1/guests/{id}/events": {
      "parameters": [
        {
          "$ref": "../components/parameters.json#/IdPath"
        }
      ],
      "get": {
        "tags": ["Guests"],
        "operationId": "listGuestEvents",
        "summary": "Guest event feed",
        "description": "Sorted by `occurredAt` descending. Tenant users with guest.event.read receive only events for their own tenant in the permitted period. Amount and external ID require separate field permissions; raw payload is not returned.",
        "x-roles": ["R-1", "R-2", "R-3 (with grant)", "R-4"],
        "x-uc": ["UC-2", "UC-6"],
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "minimum": 0 } }
        ],
        "responses": {
          "200": {
            "description": "Event page",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "$ref": "../components/schemas/events.json#/EventPage" },
                    { "$ref": "../components/schemas/tenant-guest.json#/TenantGuestEvents" }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "../components/responses.json#/Unauthorized"
          },
          "403": {
            "$ref": "../components/responses.json#/Forbidden"
          },
          "404": {
            "$ref": "../components/responses.json#/NotFound"
          }
        }
      }
    },
    "/api/v1/guests/{id}/contacts": {
      "parameters": [
        {
          "$ref": "../components/parameters.json#/IdPath"
        }
      ],
      "get": {
        "tags": ["Guests"],
        "operationId": "listGuestContacts",
        "summary": "Guest contact history",
        "description": "`contact_log` records across all exports. The control group is not logged as contacts.",
        "x-roles": ["R-1", "R-4"],
        "x-uc": ["UC-2", "UC-10"],
        "parameters": [
          {
            "$ref": "../components/parameters.json#/Page"
          },
          {
            "$ref": "../components/parameters.json#/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Contact page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../components/schemas/events.json#/ContactLogPage"
                }
              }
            }
          },
          "401": {
            "$ref": "../components/responses.json#/Unauthorized"
          },
          "403": {
            "$ref": "../components/responses.json#/Forbidden"
          },
          "404": {
            "$ref": "../components/responses.json#/NotFound"
          }
        }
      }
    }
  }
}
