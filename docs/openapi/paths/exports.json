                  "/api/v1/exports":  {
                                          "post":  {
                                                       "tags":  [
                                                                    "Exports"
                                                                ],
                                                       "operationId":  "createExport",
                                                       "summary":  "Создать выгрузку сегмента в канал",
                                                       "description":  "Обязателен заголовок `Idempotency-Key`: повтор с тем же ключом возвращает ту же выгрузку и не создаёт новых `contact_log`. Порядок: проверка ключа → версия сегмента `ready` (иначе 409 `segment_not_ready`) → фильтр по контакту канала (`sms`/`push` — телефон, `email` — email) → самое строгое правило лимита → контрольная группа по `controlSeed` → транзакционная запись с повторной проверкой лимита. Если не осталось ни одного получателя — 409 `contact_limit_exceeded` с разбивкой причин. До 20 000 членов — синхронно (201), больше — задание `export.build` (202).",
                                                       "x-roles":  [
                                                                       "R-1"
                                                                   ],
                                                       "x-uc":  [
                                                                    "UC-5",
                                                                    "UC-10"
                                                                ],
                                                       "parameters":  [
                                                                          {
                                                                              "$ref": "../components/parameters.json#/IdempotencyKey"
                                                                          }
                                                                      ],
                                                       "requestBody":  {
                                                                           "required":  true,
                                                                           "content":  {
                                                                                           "application/json":  {
                                                                                                                    "schema":  {
                                                                                                                                   "$ref": "../components/schemas/exports.json#/ExportCreateRequest"
                                                                                                                               }
                                                                                                                }
                                                                                       }
                                                                       },
                                                       "responses":  {
                                                                         "201":  {
                                                                                     "description":  "Выгрузка готова",
                                                                                     "content":  {
                                                                                                     "application/json":  {
                                                                                                                              "schema":  {
                                                                                                                                             "$ref": "../components/schemas/exports.json#/Export"
                                                                                                                                         }
                                                                                                                          }
                                                                                                 }
                                                                                 },
                                                                         "202":  {
                                                                                     "description":  "Выгрузка строится асинхронно",
                                                                                     "content":  {
                                                                                                     "application/json":  {
                                                                                                                              "schema":  {
                                                                                                                                             "$ref": "../components/schemas/exports.json#/Export"
                                                                                                                                         }
                                                                                                                          }
                                                                                                 }
                                                                                 },
