{
  "paths": {
    "/api/v1/guests/{id}/recommendations": {
      "parameters": [
        {
          "$ref": "../components/parameters.json#/IdPath"
        }
      ],
      "get": {
        "tags": ["Guests"],
        "operationId": "getGuestRecommendations",
        "summary": "Up to 3 recommendations with explanations",
        "description": "Reading does not recompute recommendations. Invariants: a listed tenant is not among the guest visited tenants; direct competitors (`tenant_category_relation.relationType = competitor`) are excluded. An empty list is a valid state, not an error.",
        "x-roles": ["R-1", "R-4"],
        "x-uc": ["UC-4"],
        "responses": {
          "200": {
            "description": "Recommendations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../components/schemas/recommendations.json#/RecommendationList"
                }
              }
            }
          },
          "401": {
            "$ref": "../components/responses.json#/Unauthorized"
          },
          "403": {
            "$ref": "../components/responses.json#/Forbidden"
          },
          "404": {
            "$ref": "../components/responses.json#/NotFound"
          }
        }
      }
    },
    "/api/v1/guests/{id}/recommendations/refresh": {
      "parameters": [
        {
          "$ref": "../components/parameters.json#/IdPath"
        }
      ],
      "post": {
        "tags": ["Guests"],
        "operationId": "refreshGuestRecommendations",
        "summary": "Force a recommendation recompute",
        "description": "Synchronous `Recommender.Refresh` call with a 10 s deadline; on timeout — 504 `timeout`. The recommendation set is replaced in a single transaction, so reads never see a partial set.",
        "x-roles": ["R-1", "R-4"],
        "x-uc": ["UC-4", "UC-15"],
        "responses": {
          "200": {
            "description": "Recomputed recommendations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../components/schemas/recommendations.json#/RecommendationList"
                }
              }
            }
          },
          "401": {
            "$ref": "../components/responses.json#/Unauthorized"
          },
          "403": {
            "$ref": "../components/responses.json#/Forbidden"
          },
          "404": {
            "$ref": "../components/responses.json#/NotFound"
          },
          "504": {
            "$ref": "../components/responses.json#/GatewayTimeout"
          }
        }
      }
    },
    "/api/v1/segments/{id}/recommendations": {
      "parameters": [
        {
          "$ref": "../components/parameters.json#/IdPath"
        }
      ],
      "get": {
        "tags": ["Guests"],
        "operationId": "getSegmentRecommendations",
        "summary": "Segment aggregate: top tenants to invite",
        "description": "Aggregates recommendations of segment members and returns the tenants most often suggested to the segment, with the number of candidate guests.",
        "x-roles": ["R-1", "R-4"],
        "x-uc": ["UC-4"],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tenant ranking for the segment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../components/schemas/recommendations.json#/SegmentRecommendationList"
                }
              }
            }
          },
          "401": {
            "$ref": "../components/responses.json#/Unauthorized"
          },
          "403": {
            "$ref": "../components/responses.json#/Forbidden"
          },
          "404": {
            "$ref": "../components/responses.json#/NotFound"
          }
        }
      }
    }
  }
}
