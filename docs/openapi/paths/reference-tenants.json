{
  "paths": {
    "/api/v1/tenants": {
      "get": {
        "tags": ["Reference"],
        "operationId": "listTenants",
        "summary": "List tenants",
        "description": "R-3 sees only its own record: the `tenant_id = :claimTenant` filter is applied in the repository and any value from the request is ignored.",
        "x-roles": ["R-1", "R-2", "R-4", "R-3 (own)"],
        "x-uc": ["UC-17", "UC-8"],
        "parameters": [
          {
            "$ref": "../components/parameters.json#/Page"
          },
          {
            "$ref": "../components/parameters.json#/PageSize"
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "category_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "is_active",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tenant page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../components/schemas/reference-tenants.json#/TenantPage"
                }
              }
            }
          },
          "401": {
            "$ref": "../components/responses.json#/Unauthorized"
          },
          "403": {
            "$ref": "../components/responses.json#/Forbidden"
          }
        }
      },
      "post": {
        "tags": ["Reference"],
        "operationId": "createTenant",
        "summary": "Create a tenant",
        "x-roles": ["R-4"],
        "x-uc": ["UC-17"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../components/schemas/reference-tenants.json#/TenantCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tenant created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../components/schemas/reference-tenants.json#/Tenant"
                }
              }
            }
          },
          "400": {
            "$ref": "../components/responses.json#/BadRequest"
          },
          "401": {
            "$ref": "../components/responses.json#/Unauthorized"
          },
          "403": {
            "$ref": "../components/responses.json#/Forbidden"
          },
          "409": {
            "$ref": "../components/responses.json#/Conflict"
          }
        }
      }
    },
    "/api/v1/tenants/{id}": {
      "parameters": [
        {
          "$ref": "../components/parameters.json#/IdPath"
        }
      ],
      "get": {
        "tags": ["Reference"],
        "operationId": "getTenant",
        "summary": "Tenant details",
        "description": "R-3 is allowed only its own record; a foreign `id` → 403 `forbidden_tenant`.",
        "x-roles": ["R-1", "R-2", "R-4", "R-3 (own)"],
        "x-uc": ["UC-17", "UC-8"],
        "responses": {
          "200": {
            "description": "Tenant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../components/schemas/reference-tenants.json#/Tenant"
                }
              }
            }
          },
          "401": {
            "$ref": "../components/responses.json#/Unauthorized"
          },
          "403": {
            "$ref": "../components/responses.json#/Forbidden"
          },
          "404": {
            "$ref": "../components/responses.json#/NotFound"
          }
        }
      },
      "patch": {
        "tags": ["Reference"],
        "operationId": "updateTenant",
        "summary": "Update a tenant",
        "description": "R-1 may change only the `priority` field (recommendation scoring priority); changing any other field → 403 `forbidden_field`.",
        "x-roles": ["R-4", "R-1 (priority)"],
        "x-uc": ["UC-17"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../components/schemas/reference-tenants.json#/TenantUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated tenant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../components/schemas/reference-tenants.json#/Tenant"
                }
              }
            }
          },
          "400": {
            "$ref": "../components/responses.json#/BadRequest"
          },
          "401": {
            "$ref": "../components/responses.json#/Unauthorized"
          },
          "403": {
            "$ref": "../components/responses.json#/Forbidden"
          },
          "404": {
            "$ref": "../components/responses.json#/NotFound"
          }
        }
      },
      "delete": {
        "tags": ["Reference"],
        "operationId": "deleteTenant",
        "summary": "Soft-delete a tenant",
        "description": "Deletion is not allowed when the tenant has events — 409 `tenant_has_events`.",
        "x-roles": ["R-4"],
        "x-uc": ["UC-17"],
        "responses": {
          "204": {
            "$ref": "../components/responses.json#/NoContent"
          },
          "401": {
            "$ref": "../components/responses.json#/Unauthorized"
          },
          "403": {
            "$ref": "../components/responses.json#/Forbidden"
          },
          "404": {
            "$ref": "../components/responses.json#/NotFound"
          },
          "409": {
            "$ref": "../components/responses.json#/Conflict"
          }
        }
      }
    }
  }
}
