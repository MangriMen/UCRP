{
  "paths": {
    "/api/v1/exports/{id}/members": {
      "parameters": [
        {
          "$ref": "../components/parameters.json#/IdPath"
        }
      ],
      "get": {
        "tags": ["Exports"],
        "operationId": "listExportMembers",
        "summary": "Recipients and control group (API export for the provider)",
        "description": "Returns only guests with a contact for the required channel. The provider calls this with the personal token of R-1. The `is_control` parameter separates recipients from the control group.",
        "x-roles": ["R-1"],
        "x-uc": ["UC-5"],
        "parameters": [
          {
            "name": "is_control",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "$ref": "../components/parameters.json#/Page"
          },
          {
            "$ref": "../components/parameters.json#/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Export member page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../components/schemas/export-members.json#/ExportMemberPage"
                }
              }
            }
          },
          "401": {
            "$ref": "../components/responses.json#/Unauthorized"
          },
          "403": {
            "$ref": "../components/responses.json#/Forbidden"
          },
          "404": {
            "$ref": "../components/responses.json#/NotFound"
          }
        }
      }
    },
    "/api/v1/exports/{id}/download": {
      "parameters": [
        {
          "$ref": "../components/parameters.json#/IdPath"
        }
      ],
      "get": {
        "tags": ["Exports"],
        "operationId": "downloadExport",
        "summary": "Export CSV (non-control recipients only)",
        "description": "The control group is not included in the file. If the export is not ready — 409 `export_not_ready`.",
        "x-roles": ["R-1"],
        "x-uc": ["UC-5"],
        "responses": {
          "200": {
            "description": "CSV file",
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                },
                "description": "attachment; filename=\"export-{id}.csv\""
              }
            },
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "$ref": "../components/responses.json#/Unauthorized"
          },
          "403": {
            "$ref": "../components/responses.json#/Forbidden"
          },
          "404": {
            "$ref": "../components/responses.json#/NotFound"
          },
          "409": {
            "$ref": "../components/responses.json#/Conflict"
          }
        }
      }
    }
  }
}
