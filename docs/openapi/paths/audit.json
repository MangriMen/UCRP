{
  "paths": {
    "/api/v1/audit-logs": {
      "get": {
        "tags": ["Audit"],
        "operationId": "listAuditLogs",
        "summary": "Audit log",
        "description": "Append-only log. Filters by entity, actor, and period. Each record contains `requestId` for end-to-end tracing.",
        "x-roles": ["R-2", "R-4"],
        "x-uc": ["UC-19"],
        "parameters": [
          {
            "name": "entity_type",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "merge_candidate"
            }
          },
          {
            "name": "entity_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "actor",
            "in": "query",
            "description": "Actor user identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "action",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "merge.confirm"
            }
          },
          {
            "$ref": "../components/parameters.json#/From"
          },
          {
            "$ref": "../components/parameters.json#/To"
          },
          {
            "$ref": "../components/parameters.json#/Page"
          },
          {
            "$ref": "../components/parameters.json#/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Audit log page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../components/schemas/audit.json#/AuditLogPage"
                }
              }
            }
          },
          "400": {
            "$ref": "../components/responses.json#/BadRequest"
          },
          "401": {
            "$ref": "../components/responses.json#/Unauthorized"
          },
          "403": {
            "$ref": "../components/responses.json#/Forbidden"
          }
        }
      }
    }
  }
}
