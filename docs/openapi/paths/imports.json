{
  "paths": {
    "/api/v1/imports": {
      "post": {
        "tags": ["Imports"],
        "operationId": "createImport",
        "summary": "Upload a source file",
        "description": "Accepts a multipart request, streams the sha256, and creates an `ImportBatch` with status `queued`, enqueuing the `import.process` job (`dedupKey = import:{batchId}`) in the same transaction as the audit record. The 202 response returns immediately and the UI polls `GET /imports/{id}` every 2 s.\n\nIf the same file (sha256) was already uploaded for this source, a 200 is returned with the existing `batchId` and `duplicate=true`, and no new events are created.\n\nLimits: up to 100,000 rows; an unsupported format or missing required columns per the mapping → 422 without creating events.",
        "x-roles": ["R-4"],
        "x-uc": ["UC-1"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["data_source_id", "file"],
                "properties": {
                  "data_source_id": {
                    "type": "string",
                    "description": "Source identifier (E-5)"
                  },
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "CSV or XLSX, UTF-8"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Duplicate file: the existing import is returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../components/schemas/imports.json#/ImportAccepted"
                }
              }
            }
          },
          "202": {
            "description": "File accepted and queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../components/schemas/imports.json#/ImportAccepted"
                }
              }
            }
          },
          "400": {
            "$ref": "../components/responses.json#/BadRequest"
          },
          "401": {
            "$ref": "../components/responses.json#/Unauthorized"
          },
          "403": {
            "$ref": "../components/responses.json#/Forbidden"
          },
          "404": {
            "$ref": "../components/responses.json#/NotFound"
          },
          "413": {
            "$ref": "../components/responses.json#/PayloadTooLarge"
          },
          "422": {
            "$ref": "../components/responses.json#/UnprocessableEntity"
          }
        }
      },
      "get": {
        "tags": ["Imports"],
        "operationId": "listImports",
        "summary": "List imports",
        "x-roles": ["R-4", "R-2"],
        "x-uc": ["UC-1", "UC-9"],
        "parameters": [
          {
            "name": "data_source_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "../components/schemas/imports.json#/ImportStatus"
            }
          },
          {
            "$ref": "../components/parameters.json#/Page"
          },
          {
            "$ref": "../components/parameters.json#/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Import page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../components/schemas/imports.json#/ImportBatchPage"
                }
              }
            }
          },
          "401": {
            "$ref": "../components/responses.json#/Unauthorized"
          },
          "403": {
            "$ref": "../components/responses.json#/Forbidden"
          }
        }
      }
    },
    "/api/v1/imports/{id}": {
      "parameters": [
        {
          "$ref": "../components/parameters.json#/IdPath"
        }
      ],
      "get": {
        "tags": ["Imports"],
        "operationId": "getImport",
        "summary": "Import status and counters",
        "description": "Invariant: `acceptedRows + rejectedRows + duplicateRows = totalRows`. Status `completed_with_errors` is set when `rejectedRows > 0`.",
        "x-roles": ["R-4", "R-2"],
        "x-uc": ["UC-1"],
        "responses": {
          "200": {
            "description": "Import",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../components/schemas/imports.json#/ImportBatch"
                }
              }
            }
          },
          "401": {
            "$ref": "../components/responses.json#/Unauthorized"
          },
          "403": {
            "$ref": "../components/responses.json#/Forbidden"
          },
          "404": {
            "$ref": "../components/responses.json#/NotFound"
          }
        }
      }
    },
    "/api/v1/imports/{id}/rejected-rows": {
      "parameters": [
        {
          "$ref": "../components/parameters.json#/IdPath"
        }
      ],
      "get": {
        "tags": ["Imports"],
        "operationId": "listRejectedRows",
        "summary": "Rejected rows with reasons",
        "description": "Reason codes: `bad_date`, `no_external_id`, `bad_amount`, `unknown_event_type`, `bad_phone`. With `format=csv` a downloadable file is returned.",
        "x-roles": ["R-4"],
        "x-uc": ["UC-1"],
        "parameters": [
          {
            "$ref": "../components/parameters.json#/Page"
          },
          {
            "$ref": "../components/parameters.json#/PageSize"
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["json", "csv"],
              "default": "json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Rejected row page or CSV",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../components/schemas/imports.json#/RejectedRowPage"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "$ref": "../components/responses.json#/Unauthorized"
          },
          "403": {
            "$ref": "../components/responses.json#/Forbidden"
          },
          "404": {
            "$ref": "../components/responses.json#/NotFound"
          }
        }
      }
    },
    "/api/v1/data-sources/{id}/sync": {
      "parameters": [
        {
          "$ref": "../components/parameters.json#/IdPath"
        }
      ],
      "post": {
        "tags": ["Imports"],
        "operationId": "syncDataSource",
        "summary": "Manually trigger a pull from an API source",
        "description": "Enqueues a `connector.pull` job with `dedupKey = pull:{sourceId}:{window}`. If a sync for the same window is already running, returns 409 `sync_in_progress`.",
        "x-roles": ["R-4"],
        "x-uc": ["UC-14"],
        "responses": {
          "202": {
            "description": "Sync queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../components/schemas/imports.json#/SyncAccepted"
                }
              }
            }
          },
          "401": {
            "$ref": "../components/responses.json#/Unauthorized"
          },
          "403": {
            "$ref": "../components/responses.json#/Forbidden"
          },
          "404": {
            "$ref": "../components/responses.json#/NotFound"
          },
          "409": {
            "$ref": "../components/responses.json#/Conflict"
          }
        }
      }
    }
  }
}
