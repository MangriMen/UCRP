{
    "paths":  {
                  "/api/v1/imports":  {
                                          "post":  {
                                                       "tags":  [
                                                                    "Imports"
                                                                ],
                                                       "operationId":  "createImport",
                                                       "summary":  "Загрузить файл источника",
                                                       "description":  "Принимает multipart-запрос, считает sha256 потоково и создаёт `ImportBatch` в статусе `queued`, ставит задание `import.process` (`dedupKey = import:{batchId}`) в одной транзакции с аудитом. Ответ 202 приходит сразу, интерфейс опрашивает `GET /imports/{id}` каждые 2 с.\n\nЕсли тот же файл (sha256) уже загружался для этого источника, возвращается 200 с существующим `batchId` и `duplicate=true`, новых событий не создаётся.\n\nОграничения: до 100 000 строк; неподдерживаемый формат или отсутствие обязательных колонок по маппингу → 422 без создания событий.",
                                                       "x-roles":  [
                                                                       "R-4"
                                                                   ],
                                                       "x-uc":  [
                                                                    "UC-1"
                                                                ],
                                                       "requestBody":  {
                                                                           "required":  true,
                                                                           "content":  {
                                                                                           "multipart/form-data":  {
                                                                                                                       "schema":  {
                                                                                                                                      "type":  "object",
                                                                                                                                      "required":  [
                                                                                                                                                       "data_source_id",
                                                                                                                                                       "file"
                                                                                                                                                   ],
                                                                                                                                      "properties":  {
                                                                                                                                                         "data_source_id":  {
                                                                                                                                                                                "type":  "string",
                                                                                                                                                                                "description":  "Идентификатор источника (E-5)"
                                                                                                                                                                            },
                                                                                                                                                         "file":  {
                                                                                                                                                                      "type":  "string",
                                                                                                                                                                      "format":  "binary",
                                                                                                                                                                      "description":  "CSV или XLSX, UTF-8"
                                                                                                                                                                  }
                                                                                                                                                     }
                                                                                                                                  }
                                                                                                                   }
                                                                                       }
                                                                       },
                                                       "responses":  {
                                                                         "200":  {
                                                                                     "description":  "Дубликат файла: возвращается существующая загрузка",
                                                                                     "content":  {
                                                                                                     "application/json":  {
                                                                                                                              "schema":  {
                                                                                                                                             "$ref": "../components/schemas/imports.json#/ImportAccepted"
                                                                                                                                         }
                                                                                                                          }
                                                                                                 }
                                                                                 },
                                                                         "202":  {
                                                                                     "description":  "Файл принят и поставлен в очередь",
                                                                                     "content":  {
                                                                                                     "application/json":  {
                                                                                                                              "schema":  {
                                                                                                                                             "$ref": "../components/schemas/imports.json#/ImportAccepted"
                                                                                                                                         }
                                                                                                                          }
                                                                                                 }
                                                                                 },
                                                                         "400":  {
                                                                                     "$ref": "../components/responses.json#/BadRequest"
                                                                                 },
                                                                         "401":  {
                                                                                     "$ref": "../components/responses.json#/Unauthorized"
                                                                                 },
                                                                         "403":  {
                                                                                     "$ref": "../components/responses.json#/Forbidden"
                                                                                 },
                                                                         "404":  {
                                                                                     "$ref": "../components/responses.json#/NotFound"
                                                                                 },
                                                                         "413":  {
                                                                                     "$ref": "../components/responses.json#/PayloadTooLarge"
                                                                                 },
                                                                         "422":  {
                                                                                     "$ref": "../components/responses.json#/UnprocessableEntity"
                                                                                 }
                                                                     }
                                                   },
                                          "get":  {
                                                      "tags":  [
                                                                   "Imports"
                                                               ],
                                                      "operationId":  "listImports",
                                                      "summary":  "Список загрузок",
                                                      "x-roles":  [
                                                                      "R-4",
                                                                      "R-2"
                                                                  ],
                                                      "x-uc":  [
                                                                   "UC-1",
                                                                   "UC-9"
                                                               ],
                                                      "parameters":  [
                                                                         {
                                                                             "name":  "data_source_id",
                                                                             "in":  "query",
                                                                             "schema":  {
                                                                                            "type":  "string"
                                                                                        }
                                                                         },
                                                                         {
                                                                             "name":  "status",
                                                                             "in":  "query",
                                                                             "schema":  {
                                                                                            "$ref": "../components/schemas/imports.json#/ImportStatus"
                                                                                        }
                                                                         },
                                                                         {
                                                                             "$ref": "../components/parameters.json#/Page"
                                                                         },
                                                                         {
                                                                             "$ref": "../components/parameters.json#/PageSize"
                                                                         }
                                                                     ],
                                                      "responses":  {
                                                                        "200":  {
                                                                                    "description":  "Страница загрузок",
                                                                                    "content":  {
                                                                                                    "application/json":  {
                                                                                                                             "schema":  {
                                                                                                                                            "$ref": "../components/schemas/imports.json#/ImportBatchPage"
                                                                                                                                        }
                                                                                                                         }
                                                                                                }
                                                                                },
                                                                        "401":  {
                                                                                    "$ref": "../components/responses.json#/Unauthorized"
                                                                                },
                                                                        "403":  {
                                                                                    "$ref": "../components/responses.json#/Forbidden"
                                                                                }
                                                                    }
                                                  }
                                      },
                  "/api/v1/imports/{id}":  {
                                               "parameters":  [
                                                                  {
                                                                      "$ref": "../components/parameters.json#/IdPath"
                                                                  }
                                                              ],
                                               "get":  {
                                                           "tags":  [
                                                                        "Imports"
                                                                    ],
                                                           "operationId":  "getImport",
                                                           "summary":  "Статус и счётчики загрузки",
                                                           "description":  "Инвариант: `acceptedRows + rejectedRows + duplicateRows = totalRows`. Статус `completed_with_errors` ставится, если `rejectedRows \u003e 0`.",
                                                           "x-roles":  [
                                                                           "R-4",
                                                                           "R-2"
                                                                       ],
                                                           "x-uc":  [
                                                                        "UC-1"
                                                                    ],
                                                           "responses":  {
                                                                             "200":  {
                                                                                         "description":  "Загрузка",
                                                                                         "content":  {
                                                                                                         "application/json":  {
                                                                                                                                  "schema":  {
                                                                                                                                                 "$ref": "../components/schemas/imports.json#/ImportBatch"
                                                                                                                                             }
                                                                                                                              }
                                                                                                     }
                                                                                     },
                                                                             "401":  {
                                                                                         "$ref": "../components/responses.json#/Unauthorized"
                                                                                     },
                                                                             "403":  {
                                                                                         "$ref": "../components/responses.json#/Forbidden"
                                                                                     },
                                                                             "404":  {
                                                                                         "$ref": "../components/responses.json#/NotFound"
                                                                                     }
                                                                         }
                                                       }
                                           },
                  "/api/v1/imports/{id}/rejected-rows":  {
                                                             "parameters":  [
                                                                                {
                                                                                    "$ref": "../components/parameters.json#/IdPath"
                                                                                }
                                                                            ],
                                                             "get":  {
                                                                         "tags":  [
                                                                                      "Imports"
                                                                                  ],
                                                                         "operationId":  "listRejectedRows",
                                                                         "summary":  "Отклонённые строки с причиной",
                                                                         "description":  "Коды причин: `bad_date`, `no_external_id`, `bad_amount`, `unknown_event_type`, `bad_phone`. При `format=csv` возвращается файл для скачивания.",
                                                                         "x-roles":  [
                                                                                         "R-4"
                                                                                     ],
                                                                         "x-uc":  [
                                                                                      "UC-1"
                                                                                  ],
                                                                         "parameters":  [
                                                                                            {
                                                                                                "$ref": "../components/parameters.json#/Page"
                                                                                            },
                                                                                            {
                                                                                                "$ref": "../components/parameters.json#/PageSize"
                                                                                            },
                                                                                            {
                                                                                                "name":  "format",
                                                                                                "in":  "query",
                                                                                                "schema":  {
                                                                                                               "type":  "string",
                                                                                                               "enum":  [
                                                                                                                            "json",
                                                                                                                            "csv"
                                                                                                                        ],
                                                                                                               "default":  "json"
                                                                                                           }
                                                                                            }
                                                                                        ],
                                                                         "responses":  {
                                                                                           "200":  {
                                                                                                       "description":  "Страница отклонённых строк или CSV",
                                                                                                       "content":  {
                                                                                                                       "application/json":  {
                                                                                                                                                "schema":  {
                                                                                                                                                               "$ref": "../components/schemas/imports.json#/RejectedRowPage"
                                                                                                                                                           }
                                                                                                                                            },
                                                                                                                       "text/csv":  {
                                                                                                                                        "schema":  {
                                                                                                                                                       "type":  "string",
                                                                                                                                                       "format":  "binary"
                                                                                                                                                   }
                                                                                                                                    }
                                                                                                                   }
                                                                                                   },
                                                                                           "401":  {
                                                                                                       "$ref": "../components/responses.json#/Unauthorized"
                                                                                                   },
                                                                                           "403":  {
                                                                                                       "$ref": "../components/responses.json#/Forbidden"
                                                                                                   },
                                                                                           "404":  {
                                                                                                       "$ref": "../components/responses.json#/NotFound"
                                                                                                   }
                                                                                       }
                                                                     }
                                                         },
                  "/api/v1/data-sources/{id}/sync":  {
                                                         "parameters":  [
                                                                            {
                                                                                "$ref": "../components/parameters.json#/IdPath"
                                                                            }
                                                                        ],
                                                         "post":  {
                                                                      "tags":  [
                                                                                   "Imports"
                                                                               ],
                                                                      "operationId":  "syncDataSource",
                                                                      "summary":  "Ручной запуск подтягивания по API-источнику",
                                                                      "description":  "Ставит задание `connector.pull` с `dedupKey = pull:{sourceId}:{window}`. Если для того же окна синхронизация уже идёт, возвращается 409 `sync_in_progress`.",
                                                                      "x-roles":  [
                                                                                      "R-4"
                                                                                  ],
                                                                      "x-uc":  [
                                                                                   "UC-14"
                                                                               ],
                                                                      "responses":  {
                                                                                        "202":  {
                                                                                                    "description":  "Синхронизация поставлена в очередь",
                                                                                                    "content":  {
                                                                                                                    "application/json":  {
                                                                                                                                             "schema":  {
                                                                                                                                                            "$ref": "../components/schemas/imports.json#/SyncAccepted"
                                                                                                                                                        }
                                                                                                                                         }
                                                                                                                }
                                                                                                },
                                                                                        "401":  {
                                                                                                    "$ref": "../components/responses.json#/Unauthorized"
                                                                                                },
                                                                                        "403":  {
                                                                                                    "$ref": "../components/responses.json#/Forbidden"
                                                                                                },
                                                                                        "404":  {
                                                                                                    "$ref": "../components/responses.json#/NotFound"
                                                                                                },
                                                                                        "409":  {
                                                                                                    "$ref": "../components/responses.json#/Conflict"
                                                                                                }
                                                                                    }
                                                                  }
                                                     }
              }
}