{
  "IdPath": {
    "name": "id",
    "in": "path",
    "required": true,
    "description": "Resource identifier (UUIDv7)",
    "schema": { "type": "string" }
  },
  "Page": {
    "name": "page",
    "in": "query",
    "description": "Page number, starting at 1",
    "schema": { "type": "integer", "minimum": 1, "default": 1 }
  },
  "PageSize": {
    "name": "page_size",
    "in": "query",
    "description": "Page size",
    "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }
  },
  "From": {
    "name": "from",
    "in": "query",
    "description": "Period start (inclusive), UTC",
    "schema": { "type": "string", "format": "date-time" }
  },
  "To": {
    "name": "to",
    "in": "query",
    "description": "Period end (inclusive), UTC",
    "schema": { "type": "string", "format": "date-time" }
  },
  "Granularity": {
    "name": "granularity",
    "in": "query",
    "schema": { "$ref": "./schemas/common.json#/Granularity" }
  },
  "IdempotencyKey": {
    "name": "Idempotency-Key",
    "in": "header",
    "required": true,
    "description": "Export idempotency key. Unique per author (UNIQUE(created_by, idempotency_key)). Repeating the same key returns the existing export.",
    "schema": { "type": "string", "minLength": 8, "maxLength": 128 }
  }
}