{
  "PenetrationBucket": {
    "type": "object",
    "required": ["one", "two", "threePlus"],
    "properties": {
      "one": {
        "type": "integer",
        "minimum": 0,
        "description": "Guests with 1 tenant"
      },
      "two": {
        "type": "integer",
        "minimum": 0,
        "description": "Guests with 2 tenants"
      },
      "threePlus": {
        "type": "integer",
        "minimum": 0,
        "description": "Guests with 3 or more tenants"
      }
    }
  },
  "PenetrationPoint": {
    "allOf": [
      {
        "$ref": "./analytics.json#/PenetrationBucket"
      },
      {
        "type": "object",
        "required": ["period"],
        "properties": {
          "period": {
            "type": "string",
            "example": "2026-09"
          },
          "penetrationRate": {
            "type": "number",
            "format": "double",
            "description": "Share of guests with 2 or more tenants"
          }
        }
      }
    ]
  },
  "PenetrationReport": {
    "type": "object",
    "required": ["from", "to", "granularity", "distribution", "penetrationRate", "series"],
    "properties": {
      "from": {
        "type": "string",
        "format": "date-time"
      },
      "to": {
        "type": "string",
        "format": "date-time"
      },
      "granularity": {
        "$ref": "./common.json#/Granularity"
      },
      "distribution": {
        "$ref": "./analytics.json#/PenetrationBucket"
      },
      "penetrationRate": {
        "type": "number",
        "format": "double",
        "description": "Share of active guests with 2 or more tenants"
      },
      "series": {
        "type": "array",
        "items": {
          "$ref": "./analytics.json#/PenetrationPoint"
        }
      }
    }
  },
  "DashboardMetrics": {
    "type": "object",
    "required": ["from", "to"],
    "properties": {
      "from": {
        "type": "string",
        "format": "date-time"
      },
      "to": {
        "type": "string",
        "format": "date-time"
      },
      "matchRate": {
        "type": "number",
        "format": "double",
        "description": "Events with guestId ÷ all accepted events in the period (target ≥ 0.70)"
      },
      "disputedMergeRate": {
        "type": "number",
        "format": "double",
        "description": "reverted ÷ (auto_merged + confirmed + reverted) (target < 0.01)"
      },
      "segmentToExportMedianSeconds": {
        "type": "number",
        "format": "double",
        "description": "Median time from segment version creation to the first export (target ≤ 300 s)"
      },
      "segmentToExportP95Seconds": {
        "type": "number",
        "format": "double"
      },
      "conversionRate": {
        "type": "number",
        "format": "double",
        "description": "Share of recipients with a visit to the target tenant within the attribution window (target ≥ 0.03)"
      },
      "incrementalRate": {
        "type": "number",
        "format": "double",
        "description": "Recipient conversion minus control group conversion (target > 0)"
      },
      "sampleSizes": {
        "type": "object",
        "properties": {
          "events": {
            "type": "integer",
            "minimum": 0
          },
          "guests": {
            "type": "integer",
            "minimum": 0
          },
          "mergeCandidates": {
            "type": "integer",
            "minimum": 0
          },
          "exports": {
            "type": "integer",
            "minimum": 0
          },
          "contacts": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
