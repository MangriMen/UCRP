{
    "PenetrationBucket":  {
                              "type":  "object",
                              "required":  [
                                               "one",
                                               "two",
                                               "threePlus"
                                           ],
                              "properties":  {
                                                 "one":  {
                                                             "type":  "integer",
                                                             "minimum":  0,
                                                             "description":  "Гостей с 1 арендатором"
                                                         },
                                                 "two":  {
                                                             "type":  "integer",
                                                             "minimum":  0,
                                                             "description":  "Гостей с 2 арендаторами"
                                                         },
                                                 "threePlus":  {
                                                                   "type":  "integer",
                                                                   "minimum":  0,
                                                                   "description":  "Гостей с 3 и более арендаторами"
                                                               }
                                             }
                          },
    "PenetrationPoint":  {
                             "allOf":  [
                                           {
                                               "$ref": "./analytics.json#/PenetrationBucket"
                                           },
                                           {
                                               "type":  "object",
                                               "required":  [
                                                                "period"
                                                            ],
                                               "properties":  {
                                                                  "period":  {
                                                                                 "type":  "string",
                                                                                 "example":  "2026-09"
                                                                             },
                                                                  "penetrationRate":  {
                                                                                          "type":  "number",
                                                                                          "format":  "double",
                                                                                          "description":  "Доля гостей с 2 и более арендаторами"
                                                                                      }
                                                              }
                                           }
                                       ]
                         },
    "PenetrationReport":  {
                              "type":  "object",
                              "required":  [
                                               "from",
                                               "to",
                                               "granularity",
                                               "distribution",
                                               "penetrationRate",
                                               "series"
                                           ],
                              "properties":  {
                                                 "from":  {
                                                              "type":  "string",
                                                              "format":  "date-time"
                                                          },
                                                 "to":  {
                                                            "type":  "string",
                                                            "format":  "date-time"
                                                        },
                                                 "granularity":  {
                                                                     "$ref": "./common.json#/Granularity"
                                                                 },
                                                 "distribution":  {
                                                                      "$ref": "./analytics.json#/PenetrationBucket"
                                                                  },
                                                 "penetrationRate":  {
                                                                         "type":  "number",
                                                                         "format":  "double",
                                                                         "description":  "Доля активных гостей с 2 и более арендаторами"
                                                                     },
                                                 "series":  {
                                                                "type":  "array",
                                                                "items":  {
                                                                              "$ref": "./analytics.json#/PenetrationPoint"
                                                                          }
                                                            }
                                             }
                          },
    "DashboardMetrics":  {
                             "type":  "object",
                             "required":  [
                                              "from",
                                              "to"
                                          ],
                             "properties":  {
                                                "from":  {
                                                             "type":  "string",
                                                             "format":  "date-time"
                                                         },
                                                "to":  {
                                                           "type":  "string",
                                                           "format":  "date-time"
                                                       },
                                                "matchRate":  {
                                                                  "type":  "number",
                                                                  "format":  "double",
                                                                  "description":  "События с guestId ÷ все принятые события за период (цель ≥ 0.70)"
                                                              },
                                                "disputedMergeRate":  {
                                                                          "type":  "number",
                                                                          "format":  "double",
                                                                          "description":  "reverted ÷ (auto_merged + confirmed + reverted) (цель \u003c 0.01)"
                                                                      },
                                                "segmentToExportMedianSeconds":  {
                                                                                     "type":  "number",
                                                                                     "format":  "double",
                                                                                     "description":  "Медиана времени от создания версии сегмента до первой выгрузки (цель ≤ 300 с)"
                                                                                 },
                                                "segmentToExportP95Seconds":  {
                                                                                  "type":  "number",
                                                                                  "format":  "double"
                                                                              },
                                                "conversionRate":  {
                                                                       "type":  "number",
                                                                       "format":  "double",
                                                                       "description":  "Доля получателей с визитом у целевого арендатора в окне атрибуции (цель ≥ 0.03)"
                                                                   },
                                                "incrementalRate":  {
                                                                        "type":  "number",
                                                                        "format":  "double",
                                                                        "description":  "Конверсия получателей минус конверсия контрольной группы (цель \u003e 0)"
                                                                    },
                                                "sampleSizes":  {
                                                                    "type":  "object",
                                                                    "properties":  {
                                                                                       "events":  {
                                                                                                      "type":  "integer",
                                                                                                      "minimum":  0
                                                                                                  },
                                                                                       "guests":  {
                                                                                                      "type":  "integer",
                                                                                                      "minimum":  0
                                                                                                  },
                                                                                       "mergeCandidates":  {
                                                                                                               "type":  "integer",
                                                                                                               "minimum":  0
                                                                                                           },
                                                                                       "exports":  {
                                                                                                       "type":  "integer",
                                                                                                       "minimum":  0
                                                                                                   },
                                                                                       "contacts":  {
                                                                                                        "type":  "integer",
                                                                                                        "minimum":  0
                                                                                                    }
                                                                                   }
                                                                }
                                            }
                         }
}