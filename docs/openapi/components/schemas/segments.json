{
    "SegmentStatus":  {
                          "type":  "string",
                          "enum":  [
                                       "pending",
                                       "computing",
                                       "ready",
                                       "failed",
                                       "archived"
                                   ]
                      },
    "SegmentRule":  {
                        "type":  "object",
                        "description":  "Segment rule (JSON DSL). Compiled into parameterized SQL, so arbitrary queries are impossible.",
                        "required":  [
                                         "periodDays"
                                     ],
                        "properties":  {
                                           "was":  {
                                                       "type":  "array",
                                                       "description":  "Guest had an event at any of these tenants",
                                                       "items":  {
                                                                     "type":  "string"
                                                                 }
                                                   },
                                           "wasNot":  {
                                                          "type":  "array",
                                                          "description":  "Guest had no events at any of these tenants",
                                                          "items":  {
                                                                        "type":  "string"
                                                                    }
                                                      },
                                           "categoriesWas":  {
                                                                 "type":  "array",
                                                                 "description":  "Guest visited a tenant in the category",
                                                                 "items":  {
                                                                               "type":  "string"
                                                                           }
                                                             },
                                           "categoriesWasNot":  {
                                                                    "type":  "array",
                                                                    "items":  {
                                                                                  "type":  "string"
                                                                              }
                                                                },
                                           "periodDays":  {
                                                              "type":  "integer",
                                                              "minimum":  1,
                                                              "maximum":  730,
                                                              "description":  "Analysis window in days"
                                                          },
                                           "requireContact":  {
                                                                  "type":  "string",
                                                                  "nullable":  true,
                                                                  "enum":  [
                                                                               "phone",
                                                                               "email"
                                                                           ],
                                                                  "description":  "Require a contact of the given type"
                                                              },
                                           "minVisits":  {
                                                             "type":  "integer",
                                                             "minimum":  1,
                                                             "nullable":  true
                                                         },
                                           "minAmountMinor":  {
                                                                  "type":  "integer",
                                                                  "format":  "int64",
                                                                  "minimum":  0,
                                                                  "nullable":  true
                                                              }
                                       }
                    },
    "SegmentVersion":  {
                           "type":  "object",
                           "required":  [
                                            "id",
                                            "segmentId",
                                            "versionNo",
                                            "rule",
                                            "status",
                                            "memberCount"
                                        ],
                           "properties":  {
                                              "id":  {
                                                         "type":  "string"
                                                     },
                                              "segmentId":  {
                                                                "type":  "string"
                                                            },
                                              "versionNo":  {
                                                                "type":  "integer",
                                                                "minimum":  1
                                                            },
                                              "rule":  {
                                                           "$ref": "./segments.json#/SegmentRule"
                                                       },
                                              "ruleText":  {
                                                               "type":  "string",
                                                               "description":  "Rule in business language"
                                                           },
                                              "status":  {
                                                             "$ref": "./segments.json#/SegmentStatus"
                                                         },
                                              "memberCount":  {
                                                                  "type":  "integer",
                                                                  "minimum":  0
                                                              },
                                              "computedAt":  {
                                                                 "type":  "string",
                                                                 "format":  "date-time",
                                                                 "nullable":  true
                                                             },
                                              "createdBy":  {
                                                                "type":  "string",
                                                                "nullable":  true
                                                            },
                                              "createdAt":  {
                                                                "type":  "string",
                                                                "format":  "date-time"
                                                            }
                                          }
                       },
    "Segment":  {
                    "type":  "object",
                    "required":  [
                                     "id",
                                     "name",
                                     "isTemplate",
                                     "currentVersionNo",
                                     "status",
                                     "memberCount",
                                     "createdAt",
                                     "updatedAt"
                                 ],
                    "properties":  {
                                       "id":  {
                                                  "type":  "string"
                                              },
                                       "name":  {
                                                    "type":  "string",
                                                    "maxLength":  200
                                                },
                                       "description":  {
                                                           "type":  "string",
                                                           "nullable":  true
                                                       },
                                       "templateCode":  {
                                                            "type":  "string",
                                                            "nullable":  true,
                                                            "example":  "sleeping_neighbor"
                                                        },
                                       "isTemplate":  {
                                                          "type":  "boolean"
                                                      },
                                       "currentVersionNo":  {
                                                                "type":  "integer",
                                                                "minimum":  1
                                                            },
                                       "status":  {
                                                      "$ref": "./segments.json#/SegmentStatus"
                                                  },
                                       "memberCount":  {
                                                           "type":  "integer",
                                                           "minimum":  0
                                                       },
                                       "computedAt":  {
                                                          "type":  "string",
                                                          "format":  "date-time",
                                                          "nullable":  true
                                                      },
                                       "rule":  {
                                                    "$ref": "./segments.json#/SegmentRule"
                                                },
                                       "ruleText":  {
                                                        "type":  "string"
                                                    },
                                       "createdBy":  {
                                                         "type":  "string",
                                                         "nullable":  true
                                                     },
                                       "createdAt":  {
                                                         "type":  "string",
                                                         "format":  "date-time"
                                                     },
                                       "updatedAt":  {
                                                         "type":  "string",
                                                         "format":  "date-time"
                                                     }
                                   }
                }
}