{
    "ExportMember":  {
                         "type":  "object",
                         "required":  [
                                          "guestId",
                                          "isControl"
                                      ],
                         "properties":  {
                                            "guestId":  {
                                                            "type":  "string"
                                                        },
                                            "displayName":  {
                                                                "type":  "string",
                                                                "nullable":  true
                                                            },
                                            "isControl":  {
                                                              "type":  "boolean"
                                                          },
                                            "identifierId":  {
                                                                 "type":  "string",
                                                                 "description":  "Channel contact used"
                                                             },
                                            "contact":  {
                                                            "type":  "object",
                                                            "required":  [
                                                                             "idType",
                                                                             "value"
                                                                         ],
                                                            "properties":  {
                                                                               "idType":  {
                                                                                              "$ref": "./guests.json#/IdentifierType"
                                                                                          },
                                                                               "value":  {
                                                                                             "type":  "string",
                                                                                             "description":  "Normalized contact value"
                                                                                         }
                                                                           }
                                                        }
                                        }
                     },
    "ExportMemberPage":  {
                             "type":  "object",
                             "required":  [
                                              "items",
                                              "meta"
                                          ],
                             "properties":  {
                                                "items":  {
                                                              "type":  "array",
                                                              "items":  {
                                                                            "$ref": "./export-members.json#/ExportMember"
                                                                        }
                                                          },
                                                "meta":  {
                                                             "$ref": "./common.json#/PageMeta"
                                                         }
                                            }
                         },
    "ContactLimit":  {
                         "type":  "object",
                         "required":  [
                                          "id",
                                          "maxContacts",
                                          "periodDays"
                                      ],
                         "properties":  {
                                            "id":  {
                                                       "type":  "string"
                                                   },
                                            "channel":  {
                                                            "type":  "string",
                                                            "nullable":  true,
                                                            "enum":  [
                                                                         "sms",
                                                                         "push",
                                                                         "email"
                                                                     ],
                                                            "description":  "null — rule applies to all channels"
                                                        },
                                            "maxContacts":  {
                                                                "type":  "integer",
                                                                "minimum":  1,
                                                                "maximum":  100
                                                            },
                                            "periodDays":  {
                                                               "type":  "integer",
                                                               "minimum":  1,
                                                               "maximum":  365
                                                           },
                                            "createdBy":  {
                                                              "type":  "string",
                                                              "nullable":  true
                                                          },
                                            "createdAt":  {
                                                              "type":  "string",
                                                              "format":  "date-time"
                                                          },
                                            "updatedAt":  {
                                                              "type":  "string",
                                                              "format":  "date-time"
                                                          }
                                        }
                     },
    "ContactLimitCreateRequest":  {
                                      "type":  "object",
                                      "required":  [
                                                       "maxContacts",
                                                       "periodDays"
                                                   ],
                                      "properties":  {
                                                         "channel":  {
                                                                         "type":  "string",
                                                                         "nullable":  true,
                                                                         "enum":  [
                                                                                      "sms",
                                                                                      "push",
                                                                                      "email"
                                                                                  ]
                                                                     },
                                                         "maxContacts":  {
                                                                             "type":  "integer",
                                                                             "minimum":  1,
                                                                             "maximum":  100
                                                                         },
                                                         "periodDays":  {
                                                                            "type":  "integer",
                                                                            "minimum":  1,
                                                                            "maximum":  365
                                                                        }
                                                     }
                                  },
    "ContactLimitUpdateRequest":  {
                                      "type":  "object",
                                      "properties":  {
                                                         "channel":  {
                                                                         "type":  "string",
                                                                         "nullable":  true,
                                                                         "enum":  [
                                                                                      "sms",
                                                                                      "push",
                                                                                      "email"
                                                                                  ]
                                                                     },
                                                         "maxContacts":  {
                                                                             "type":  "integer",
                                                                             "minimum":  1,
                                                                             "maximum":  100
                                                                         },
                                                         "periodDays":  {
                                                                            "type":  "integer",
                                                                            "minimum":  1,
                                                                            "maximum":  365
                                                                        }
                                                     }
                                  }
}