{
    "GuestStatus":  {
                        "type":  "string",
                        "enum":  [
                                     "active",
                                     "merged",
                                     "deleted"
                                 ]
                    },
    "IdentifierType":  {
                           "type":  "string",
                           "description":  "Тип идентификатора. `phone` и `email` — надёжные ключи склейки.",
                           "enum":  [
                                        "phone",
                                        "email",
                                        "card",
                                        "loyalty_id",
                                        "wifi_mac",
                                        "car_plate"
                                    ]
                       },
    "GuestIdentifier":  {
                            "type":  "object",
                            "required":  [
                                             "id",
                                             "guestId",
                                             "idType",
                                             "valueNormalized"
                                         ],
                            "properties":  {
                                               "id":  {
                                                          "type":  "string"
                                                      },
                                               "guestId":  {
                                                               "type":  "string"
                                                           },
                                               "idType":  {
                                                              "$ref": "./guests.json#/IdentifierType"
                                                          },
                                               "valueNormalized":  {
                                                                       "type":  "string",
                                                                       "description":  "Нормализованное значение: телефон в E.164 без `+`, email в нижнем регистре",
                                                                       "example":  "79001234567"
                                                                   },
                                               "dataSourceId":  {
                                                                    "type":  "string",
                                                                    "nullable":  true
                                                                },
                                               "originGuestId":  {
                                                                     "type":  "string",
                                                                     "nullable":  true,
                                                                     "description":  "Исходный владелец ключа до склейки — основа обратимости"
                                                                 },
                                               "isReliable":  {
                                                                  "type":  "boolean",
                                                                  "description":  "Ключ пригоден для автосклейки"
                                                              },
                                               "createdAt":  {
                                                                 "type":  "string",
                                                                 "format":  "date-time"
                                                             }
                                           }
                        },
    "Guest":  {
                  "type":  "object",
                  "required":  [
                                   "id",
                                   "status",
                                   "tenantCount",
                                   "createdAt"
                               ],
                  "properties":  {
                                     "id":  {
                                                "type":  "string"
                                            },
                                     "displayName":  {
                                                         "type":  "string",
                                                         "nullable":  true
                                                     },
                                     "status":  {
                                                    "$ref": "./guests.json#/GuestStatus"
                                                },
                                     "mergedIntoId":  {
                                                          "type":  "string",
                                                          "nullable":  true,
                                                          "description":  "Актуальный профиль, если гость был поглощён склейкой"
                                                      },
                                     "tenantCount":  {
                                                         "type":  "integer",
                                                         "minimum":  0,
                                                         "description":  "Число различных арендаторов в событиях гостя"
                                                     },
                                     "eventCount":  {
                                                        "type":  "integer",
                                                        "minimum":  0
                                                    },
                                     "firstSeenAt":  {
                                                         "type":  "string",
                                                         "format":  "date-time",
                                                         "nullable":  true
                                                     },
                                     "lastSeenAt":  {
                                                        "type":  "string",
                                                        "format":  "date-time",
                                                        "nullable":  true
                                                    },
                                     "createdAt":  {
                                                       "type":  "string",
                                                       "format":  "date-time"
                                                   },
                                     "updatedAt":  {
                                                       "type":  "string",
                                                       "format":  "date-time"
                                                   },
                                     "deletedAt":  {
                                                       "type":  "string",
                                                       "format":  "date-time",
                                                       "nullable":  true
                                                   }
                                 }
              },
    "GuestTenantSummary":  {
                               "type":  "object",
                               "required":  [
                                                "tenantId",
                                                "tenantName",
                                                "eventCount"
                                            ],
                               "properties":  {
                                                  "tenantId":  {
                                                                   "type":  "string"
                                                               },
                                                  "tenantName":  {
                                                                     "type":  "string"
                                                                 },
                                                  "categoryName":  {
                                                                       "type":  "string",
                                                                       "nullable":  true
                                                                   },
                                                  "floor":  {
                                                                "type":  "integer",
                                                                "nullable":  true
                                                            },
                                                  "eventCount":  {
                                                                     "type":  "integer",
                                                                     "minimum":  0
                                                                 },
                                                  "lastVisitAt":  {
                                                                      "type":  "string",
                                                                      "format":  "date-time",
                                                                      "nullable":  true
                                                                  }
                                              }
                           },
    "GuestSegmentSummary":  {
                                "type":  "object",
                                "required":  [
                                                 "segmentId",
                                                 "name"
                                             ],
                                "properties":  {
                                                   "segmentId":  {
                                                                     "type":  "string"
                                                                 },
                                                   "name":  {
                                                                "type":  "string"
                                                            },
                                                   "versionNo":  {
                                                                     "type":  "integer"
                                                                 }
                                               }
                            },
    "GuestProfile":  {
                         "allOf":  [
                                       {
                                           "$ref": "./guests.json#/Guest"
                                       },
                                       {
                                           "type":  "object",
                                           "required":  [
                                                            "identifiers",
                                                            "tenants",
                                                            "segments"
                                                        ],
                                           "properties":  {
                                                              "identifiers":  {
                                                                                  "type":  "array",
                                                                                  "items":  {
                                                                                                "$ref": "./guests.json#/GuestIdentifier"
                                                                                            }
                                                                              },
                                                              "tenants":  {
                                                                              "type":  "array",
                                                                              "items":  {
                                                                                            "$ref": "./guests.json#/GuestTenantSummary"
                                                                                        }
                                                                          },
                                                              "segments":  {
                                                                               "type":  "array",
                                                                               "items":  {
                                                                                             "$ref": "./guests.json#/GuestSegmentSummary"
                                                                                         }
                                                                           },
                                                              "totalAmountMinor":  {
                                                                                       "type":  "integer",
                                                                                       "format":  "int64",
                                                                                       "description":  "Суммарная выручка гостя в минорных единицах"
                                                                                   },
                                                              "currency":  {
                                                                               "type":  "string",
                                                                               "example":  "RUB"
                                                                           }
                                                          }
                                       }
                                   ]
                     },
    "GuestPage":  {
                      "type":  "object",
                      "required":  [
                                       "items",
                                       "meta"
                                   ],
                      "properties":  {
                                         "items":  {
                                                       "type":  "array",
                                                       "items":  {
                                                                     "$ref": "./guests.json#/Guest"
                                                                 }
                                                   },
                                         "meta":  {
                                                      "$ref": "./common.json#/PageMeta"
                                                  }
                                     }
                  }
}