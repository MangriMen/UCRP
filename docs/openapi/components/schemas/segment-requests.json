{
  "SegmentCreateRequest": {
    "type": "object",
    "required": ["name", "rule"],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "description": {
        "type": "string",
        "nullable": true,
        "maxLength": 1000
      },
      "templateCode": {
        "type": "string",
        "nullable": true,
        "description": "When set, template parameters are applied to the rule"
      },
      "rule": {
        "$ref": "./segments.json#/SegmentRuleNode"
      }
    }
  },
  "SegmentUpdateRequest": {
    "type": "object",
    "required": ["rule"],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "description": {
        "type": "string",
        "nullable": true,
        "maxLength": 1000
      },
      "rule": {
        "$ref": "./segments.json#/SegmentRuleNode"
      }
    }
  },
  "SegmentPreviewRequest": {
    "type": "object",
    "required": ["rule"],
    "properties": {
      "rule": {
        "$ref": "./segments.json#/SegmentRuleNode"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 20,
        "description": "How many examples to return"
      }
    }
  },
  "SegmentPreviewExample": {
    "type": "object",
    "required": ["guestId"],
    "properties": {
      "guestId": {
        "type": "string"
      },
      "displayName": {
        "type": "string",
        "nullable": true
      },
      "tenantCount": {
        "type": "integer",
        "minimum": 0
      },
      "lastSeenAt": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      }
    }
  },
  "SegmentPreviewResponse": {
    "type": "object",
    "required": ["size", "examples", "cached", "suppressed"],
    "properties": {
      "size": {
        "type": "integer",
        "minimum": 0,
        "nullable": true,
        "description": "Null when fewer than five guests match; examples are then empty."
      },
      "suppressed": {
        "type": "boolean"
      },
      "examples": {
        "type": "array",
        "items": {
          "$ref": "./segment-requests.json#/SegmentPreviewExample"
        }
      },
      "cached": {
        "type": "boolean",
        "description": "Result served from cache by rule hash"
      },
      "computedInMs": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "SegmentMember": {
    "type": "object",
    "required": ["guestId"],
    "properties": {
      "guestId": {
        "type": "string"
      },
      "displayName": {
        "type": "string",
        "nullable": true
      },
      "tenantCount": {
        "type": "integer",
        "minimum": 0
      },
      "lastSeenAt": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "addedAt": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "SegmentMemberPage": {
    "type": "object",
    "required": ["items", "meta"],
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "$ref": "./segment-requests.json#/SegmentMember"
        }
      },
      "meta": {
        "$ref": "./common.json#/PageMeta"
      }
    }
  },
  "SegmentPage": {
    "type": "object",
    "required": ["items", "meta"],
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "$ref": "./segments.json#/Segment"
        }
      },
      "meta": {
        "$ref": "./common.json#/PageMeta"
      }
    }
  },
  "SegmentTemplate": {
    "type": "object",
    "required": ["code", "name", "rule"],
    "properties": {
      "code": {
        "type": "string",
        "enum": ["sleeping_neighbor", "single_store", "churn_risk", "newcomer", "high_value"]
      },
      "name": {
        "type": "string",
        "example": "Sleeping neighbor"
      },
      "description": {
        "type": "string"
      },
      "rule": {
        "$ref": "./segments.json#/SegmentRuleNode"
      },
      "defaultPeriodDays": {
        "type": "integer",
        "minimum": 1
      }
    }
  }
}
