{
  "EventType": {
    "type": "object",
    "required": ["id", "code", "name", "hasAmount", "countsAsPresence", "isActive"],
    "properties": {
      "id": {
        "type": "string"
      },
      "code": {
        "type": "string",
        "maxLength": 64,
        "example": "purchase"
      },
      "name": {
        "type": "string",
        "maxLength": 200
      },
      "hasAmount": {
        "type": "boolean",
        "description": "The event carries a monetary amount"
      },
      "countsAsPresence": {
        "type": "boolean",
        "description": "The event counts as a visit and participates in cross-tenant penetration"
      },
      "isActive": {
        "type": "boolean"
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      },
      "updatedAt": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "EventTypeRequest": {
    "type": "object",
    "required": ["code", "name", "hasAmount", "countsAsPresence"],
    "properties": {
      "code": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "hasAmount": {
        "type": "boolean"
      },
      "countsAsPresence": {
        "type": "boolean"
      },
      "isActive": {
        "type": "boolean",
        "default": true
      }
    }
  }
}
