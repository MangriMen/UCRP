{
    "EventType":  {
                      "type":  "object",
                      "required":  [
                                       "id",
                                       "code",
                                       "name",
                                       "hasAmount",
                                       "countsAsPresence",
                                       "isActive"
                                   ],
                      "properties":  {
                                         "id":  {
                                                    "type":  "string"
                                                },
                                         "code":  {
                                                      "type":  "string",
                                                      "maxLength":  64,
                                                      "example":  "purchase"
                                                  },
                                         "name":  {
                                                      "type":  "string",
                                                      "maxLength":  200
                                                  },
                                         "hasAmount":  {
                                                           "type":  "boolean",
                                                           "description":  "У события есть денежная сумма"
                                                       },
                                         "countsAsPresence":  {
                                                                  "type":  "boolean",
                                                                  "description":  "Событие считается посещением и участвует в cross-tenant penetration"
                                                              },
                                         "isActive":  {
                                                          "type":  "boolean"
                                                      },
                                         "createdAt":  {
                                                           "type":  "string",
                                                           "format":  "date-time"
                                                       },
                                         "updatedAt":  {
                                                           "type":  "string",
                                                           "format":  "date-time"
                                                       }
                                     }
                  },
    "EventTypeRequest":  {
                             "type":  "object",
                             "required":  [
                                              "code",
                                              "name",
                                              "hasAmount",
                                              "countsAsPresence"
                                          ],
                             "properties":  {
                                                "code":  {
                                                             "type":  "string",
                                                             "minLength":  1,
                                                             "maxLength":  64
                                                         },
                                                "name":  {
                                                             "type":  "string",
                                                             "minLength":  1,
                                                             "maxLength":  200
                                                         },
                                                "hasAmount":  {
                                                                  "type":  "boolean"
                                                              },
                                                "countsAsPresence":  {
                                                                         "type":  "boolean"
                                                                     },
                                                "isActive":  {
                                                                 "type":  "boolean",
                                                                 "default":  true
                                                             }
                                            }
                         }
}