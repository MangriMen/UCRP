{
  "CampaignStatus": {
    "type": "string",
    "enum": ["draft", "active", "finished", "archived"]
  },
  "Campaign": {
    "type": "object",
    "required": [
      "id",
      "name",
      "targetTenantId",
      "segmentId",
      "attributionDays",
      "status",
      "createdAt",
      "updatedAt"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string",
        "maxLength": 200
      },
      "targetTenantId": {
        "type": "string"
      },
      "targetTenantName": {
        "type": "string",
        "readOnly": true
      },
      "segmentId": {
        "type": "string"
      },
      "segmentName": {
        "type": "string",
        "readOnly": true
      },
      "attributionDays": {
        "type": "integer",
        "minimum": 1,
        "maximum": 90,
        "default": 14,
        "description": "Attribution window after contact"
      },
      "status": {
        "$ref": "./campaigns.json#/CampaignStatus"
      },
      "startsAt": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "endsAt": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "createdBy": {
        "type": "string",
        "nullable": true
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      },
      "updatedAt": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "CampaignCreateRequest": {
    "type": "object",
    "required": ["name", "targetTenantId", "segmentId"],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "targetTenantId": {
        "type": "string"
      },
      "segmentId": {
        "type": "string"
      },
      "attributionDays": {
        "type": "integer",
        "minimum": 1,
        "maximum": 90,
        "default": 14
      },
      "startsAt": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "endsAt": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      }
    }
  },
  "CampaignUpdateRequest": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "status": {
        "$ref": "./campaigns.json#/CampaignStatus"
      },
      "attributionDays": {
        "type": "integer",
        "minimum": 1,
        "maximum": 90
      },
      "startsAt": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "endsAt": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      }
    }
  },
  "CampaignPage": {
    "type": "object",
    "required": ["items", "meta"],
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "$ref": "./campaigns.json#/Campaign"
        }
      },
      "meta": {
        "$ref": "./common.json#/PageMeta"
      }
    }
  },
  "CampaignResults": {
    "type": "object",
    "required": ["campaignId", "recipients", "controlGroup", "conversions", "conversionRate"],
    "properties": {
      "campaignId": {
        "type": "string"
      },
      "segmentId": {
        "type": "string"
      },
      "attributionDays": {
        "type": "integer"
      },
      "recipients": {
        "type": "integer",
        "minimum": 0,
        "description": "Number of recipients (contact_log)"
      },
      "controlGroup": {
        "type": "integer",
        "minimum": 0
      },
      "conversions": {
        "type": "integer",
        "minimum": 0,
        "description": "Recipients with a visit within the attribution window"
      },
      "conversionRate": {
        "type": "number",
        "format": "double",
        "description": "Recipient conversion rate"
      },
      "controlConversions": {
        "type": "integer",
        "minimum": 0
      },
      "controlConversionRate": {
        "type": "number",
        "format": "double"
      },
      "incrementalRate": {
        "type": "number",
        "format": "double",
        "description": "Conversion difference: recipients minus control group"
      },
      "incrementalVisits": {
        "type": "integer",
        "description": "Estimated incremental visits"
      },
      "pValue": {
        "type": "number",
        "format": "double",
        "nullable": true,
        "description": "Significance (two-sample test of proportions)"
      },
      "isSignificant": {
        "type": "boolean",
        "nullable": true
      },
      "computedAt": {
        "type": "string",
        "format": "date-time"
      }
    }
  }
}
