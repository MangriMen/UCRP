{
    "CampaignStatus":  {
                           "type":  "string",
                           "enum":  [
                                        "draft",
                                        "active",
                                        "finished",
                                        "archived"
                                    ]
                       },
    "Campaign":  {
                     "type":  "object",
                     "required":  [
                                      "id",
                                      "name",
                                      "targetTenantId",
                                      "segmentId",
                                      "attributionDays",
                                      "status",
                                      "createdAt",
                                      "updatedAt"
                                  ],
                     "properties":  {
                                        "id":  {
                                                   "type":  "string"
                                               },
                                        "name":  {
                                                     "type":  "string",
                                                     "maxLength":  200
                                                 },
                                        "targetTenantId":  {
                                                               "type":  "string"
                                                           },
                                        "targetTenantName":  {
                                                                 "type":  "string",
                                                                 "readOnly":  true
                                                             },
                                        "segmentId":  {
                                                          "type":  "string"
                                                      },
                                        "segmentName":  {
                                                            "type":  "string",
                                                            "readOnly":  true
                                                        },
                                        "attributionDays":  {
                                                                "type":  "integer",
                                                                "minimum":  1,
                                                                "maximum":  90,
                                                                "default":  14,
                                                                "description":  "Окно атрибуции после контакта"
                                                            },
                                        "status":  {
                                                       "$ref": "./campaigns.json#/CampaignStatus"
                                                   },
                                        "startsAt":  {
                                                         "type":  "string",
                                                         "format":  "date-time",
                                                         "nullable":  true
                                                     },
                                        "endsAt":  {
                                                       "type":  "string",
                                                       "format":  "date-time",
                                                       "nullable":  true
                                                   },
                                        "createdBy":  {
                                                          "type":  "string",
                                                          "nullable":  true
                                                      },
                                        "createdAt":  {
                                                          "type":  "string",
                                                          "format":  "date-time"
                                                      },
                                        "updatedAt":  {
                                                          "type":  "string",
                                                          "format":  "date-time"
                                                      }
                                    }
                 },
    "CampaignCreateRequest":  {
                                  "type":  "object",
                                  "required":  [
                                                   "name",
                                                   "targetTenantId",
                                                   "segmentId"
                                               ],
                                  "properties":  {
                                                     "name":  {
                                                                  "type":  "string",
                                                                  "minLength":  1,
                                                                  "maxLength":  200
                                                              },
                                                     "targetTenantId":  {
                                                                            "type":  "string"
                                                                        },
                                                     "segmentId":  {
                                                                       "type":  "string"
                                                                   },
                                                     "attributionDays":  {
                                                                             "type":  "integer",
                                                                             "minimum":  1,
                                                                             "maximum":  90,
                                                                             "default":  14
                                                                         },
                                                     "startsAt":  {
                                                                      "type":  "string",
                                                                      "format":  "date-time",
                                                                      "nullable":  true
                                                                  },
                                                     "endsAt":  {
                                                                    "type":  "string",
                                                                    "format":  "date-time",
                                                                    "nullable":  true
                                                                }
                                                 }
                              },
    "CampaignUpdateRequest":  {
                                  "type":  "object",
                                  "properties":  {
                                                     "name":  {
                                                                  "type":  "string",
                                                                  "minLength":  1,
                                                                  "maxLength":  200
                                                              },
                                                     "status":  {
                                                                    "$ref": "./campaigns.json#/CampaignStatus"
                                                                },
                                                     "attributionDays":  {
                                                                             "type":  "integer",
                                                                             "minimum":  1,
                                                                             "maximum":  90
                                                                         },
                                                     "startsAt":  {
                                                                      "type":  "string",
                                                                      "format":  "date-time",
                                                                      "nullable":  true
                                                                  },
                                                     "endsAt":  {
                                                                    "type":  "string",
                                                                    "format":  "date-time",
                                                                    "nullable":  true
                                                                }
                                                 }
                              },
    "CampaignPage":  {
                         "type":  "object",
                         "required":  [
                                          "items",
                                          "meta"
                                      ],
                         "properties":  {
                                            "items":  {
                                                          "type":  "array",
                                                          "items":  {
                                                                        "$ref": "./campaigns.json#/Campaign"
                                                                    }
                                                      },
                                            "meta":  {
                                                         "$ref": "./common.json#/PageMeta"
                                                     }
                                        }
                     },
    "CampaignResults":  {
                            "type":  "object",
                            "required":  [
                                             "campaignId",
                                             "recipients",
                                             "controlGroup",
                                             "conversions",
                                             "conversionRate"
                                         ],
                            "properties":  {
                                               "campaignId":  {
                                                                  "type":  "string"
                                                              },
                                               "segmentId":  {
                                                                 "type":  "string"
                                                             },
                                               "attributionDays":  {
                                                                       "type":  "integer"
                                                                   },
                                               "recipients":  {
                                                                  "type":  "integer",
                                                                  "minimum":  0,
                                                                  "description":  "Число получателей (contact_log)"
                                                              },
                                               "controlGroup":  {
                                                                    "type":  "integer",
                                                                    "minimum":  0
                                                                },
                                               "conversions":  {
                                                                   "type":  "integer",
                                                                   "minimum":  0,
                                                                   "description":  "Получатели с визитом в окне атрибуции"
                                                               },
                                               "conversionRate":  {
                                                                      "type":  "number",
                                                                      "format":  "double",
                                                                      "description":  "Доля конверсии получателей"
                                                                  },
                                               "controlConversions":  {
                                                                          "type":  "integer",
                                                                          "minimum":  0
                                                                      },
                                               "controlConversionRate":  {
                                                                             "type":  "number",
                                                                             "format":  "double"
                                                                         },
                                               "incrementalRate":  {
                                                                       "type":  "number",
                                                                       "format":  "double",
                                                                       "description":  "Разность конверсий: получатели минус контрольная группа"
                                                                   },
                                               "incrementalVisits":  {
                                                                         "type":  "integer",
                                                                         "description":  "Оценка дополнительных визитов"
                                                                     },
                                               "pValue":  {
                                                              "type":  "number",
                                                              "format":  "double",
                                                              "nullable":  true,
                                                              "description":  "Значимость (двухвыборочный тест долей)"
                                                          },
                                               "isSignificant":  {
                                                                     "type":  "boolean",
                                                                     "nullable":  true
                                                                 },
                                               "computedAt":  {
                                                                  "type":  "string",
                                                                  "format":  "date-time"
                                                              }
                                           }
                        }
}