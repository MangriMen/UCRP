{
  "TenantAggregatePoint": {
    "type": "object",
    "required": ["period"],
    "properties": {
      "period": {
        "type": "string",
        "example": "2026-09"
      },
      "newGuests": {
        "type": "integer",
        "nullable": true,
        "description": "null if the value is below the k = 5 threshold"
      },
      "repeatVisits": {
        "type": "integer",
        "nullable": true
      }
    }
  },
  "TenantAggregates": {
    "type": "object",
    "required": ["tenantId", "tenantName", "from", "to", "suppressed", "series"],
    "properties": {
      "tenantId": {
        "type": "string"
      },
      "tenantName": {
        "type": "string"
      },
      "from": {
        "type": "string",
        "format": "date-time"
      },
      "to": {
        "type": "string",
        "format": "date-time"
      },
      "newGuestsViaComplex": {
        "type": "integer",
        "nullable": true,
        "description": "New guests acquired through the complex (A-13). null when the value is < k"
      },
      "repeatVisits": {
        "type": "integer",
        "nullable": true
      },
      "suppressed": {
        "type": "boolean",
        "description": "true — some cells are suppressed by the k = 5 threshold"
      },
      "suppressionThreshold": {
        "type": "integer",
        "default": 5
      },
      "series": {
        "type": "array",
        "items": {
          "$ref": "./analytics-tenant.json#/TenantAggregatePoint"
        }
      }
    }
  },
  "DataQualityListItem": {
    "type": "object",
    "required": ["data_source_id", "name", "rejected_rate", "pending_merges", "warning", "suppressed"],
    "properties": {
      "data_source_id": { "type": "string" },
      "name": { "type": "string" },
      "last_import_at": { "type": "string", "format": "date-time" },
      "rejected_rate": { "type": "number", "nullable": true },
      "pending_merges": { "type": "integer", "nullable": true },
      "warning": { "type": "boolean", "nullable": true },
      "suppressed": { "type": "boolean" }
    }
  },
  "DataQualitySource": {
    "type": "object",
    "required": [
      "dataSourceId",
      "dataSourceName",
      "rejectedShare30d",
      "pendingMergeCandidates",
      "hasWarning"
    ],
    "properties": {
      "dataSourceId": {
        "type": "string"
      },
      "dataSourceName": {
        "type": "string"
      },
      "tenantId": {
        "type": "string",
        "nullable": true
      },
      "tenantName": {
        "type": "string",
        "nullable": true
      },
      "lastSuccessfulImportAt": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "rejectedShare30d": {
        "type": "number",
        "format": "double",
        "description": "Share of rejected rows over 30 days"
      },
      "pendingMergeCandidates": {
        "type": "integer",
        "minimum": 0,
        "description": "Disputed profiles linked to the source"
      },
      "hasWarning": {
        "type": "boolean"
      },
      "warningReasons": {
        "type": "array",
        "description": "For example: `rejected_share_above_10pct`, `data_older_than_7_days`",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "DataQualityPoint": {
    "type": "object",
    "required": ["date"],
    "properties": {
      "date": {
        "type": "string",
        "format": "date"
      },
      "totalRows": {
        "type": "integer",
        "minimum": 0
      },
      "rejectedRows": {
        "type": "integer",
        "minimum": 0
      },
      "rejectedShare": {
        "type": "number",
        "format": "double"
      }
    }
  },
  "DataQualitySourceDetail": {
    "allOf": [
      {
        "$ref": "./analytics-tenant.json#/DataQualitySource"
      },
      {
        "type": "object",
        "required": ["series", "recentBatches"],
        "properties": {
          "series": {
            "type": "array",
            "items": {
              "$ref": "./analytics-tenant.json#/DataQualityPoint"
            }
          },
          "recentBatches": {
            "type": "array",
            "items": {
              "$ref": "./imports.json#/ImportBatch"
            }
          }
        }
      }
    ]
  }
}
