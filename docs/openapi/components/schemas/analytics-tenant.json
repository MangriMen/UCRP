{
    "TenantAggregatePoint":  {
                                 "type":  "object",
                                 "required":  [
                                                  "period"
                                              ],
                                 "properties":  {
                                                    "period":  {
                                                                   "type":  "string",
                                                                   "example":  "2026-09"
                                                               },
                                                    "newGuests":  {
                                                                      "type":  "integer",
                                                                      "nullable":  true,
                                                                      "description":  "null, если значение меньше порога k = 5"
                                                                  },
                                                    "repeatVisits":  {
                                                                         "type":  "integer",
                                                                         "nullable":  true
                                                                     }
                                                }
                             },
    "TenantAggregates":  {
                             "type":  "object",
                             "required":  [
                                              "tenantId",
                                              "tenantName",
                                              "from",
                                              "to",
                                              "suppressed",
                                              "series"
                                          ],
                             "properties":  {
                                                "tenantId":  {
                                                                 "type":  "string"
                                                             },
                                                "tenantName":  {
                                                                   "type":  "string"
                                                               },
                                                "from":  {
                                                             "type":  "string",
                                                             "format":  "date-time"
                                                         },
                                                "to":  {
                                                           "type":  "string",
                                                           "format":  "date-time"
                                                       },
                                                "newGuestsViaComplex":  {
                                                                            "type":  "integer",
                                                                            "nullable":  true,
                                                                            "description":  "Новые гости, пришедшие через комплекс (A-13). null при значении \u003c k"
                                                                        },
                                                "repeatVisits":  {
                                                                     "type":  "integer",
                                                                     "nullable":  true
                                                                 },
                                                "suppressed":  {
                                                                   "type":  "boolean",
                                                                   "description":  "true — часть ячеек скрыта порогом k = 5"
                                                               },
                                                "suppressionThreshold":  {
                                                                             "type":  "integer",
                                                                             "default":  5
                                                                         },
                                                "series":  {
                                                               "type":  "array",
                                                               "items":  {
                                                                             "$ref": "./analytics-tenant.json#/TenantAggregatePoint"
                                                                         }
                                                           }
                                            }
                         },
    "DataQualitySource":  {
                              "type":  "object",
                              "required":  [
                                               "dataSourceId",
                                               "dataSourceName",
                                               "rejectedShare30d",
                                               "pendingMergeCandidates",
                                               "hasWarning"
                                           ],
                              "properties":  {
                                                 "dataSourceId":  {
                                                                      "type":  "string"
                                                                  },
                                                 "dataSourceName":  {
                                                                        "type":  "string"
                                                                    },
                                                 "tenantId":  {
                                                                  "type":  "string",
                                                                  "nullable":  true
                                                              },
                                                 "tenantName":  {
                                                                    "type":  "string",
                                                                    "nullable":  true
                                                                },
                                                 "lastSuccessfulImportAt":  {
                                                                                "type":  "string",
                                                                                "format":  "date-time",
                                                                                "nullable":  true
                                                                            },
                                                 "rejectedShare30d":  {
                                                                          "type":  "number",
                                                                          "format":  "double",
                                                                          "description":  "Доля отклонённых строк за 30 дней"
                                                                      },
                                                 "pendingMergeCandidates":  {
                                                                                "type":  "integer",
                                                                                "minimum":  0,
                                                                                "description":  "Спорные профили, связанные с источником"
                                                                            },
                                                 "hasWarning":  {
                                                                    "type":  "boolean"
                                                                },
                                                 "warningReasons":  {
                                                                        "type":  "array",
                                                                        "description":  "Например: `rejected_share_above_10pct`, `data_older_than_7_days`",
                                                                        "items":  {
                                                                                      "type":  "string"
                                                                                  }
                                                                    }
                                             }
                          },
    "DataQualityPoint":  {
                             "type":  "object",
                             "required":  [
                                              "date"
                                          ],
                             "properties":  {
                                                "date":  {
                                                             "type":  "string",
                                                             "format":  "date"
                                                         },
                                                "totalRows":  {
                                                                  "type":  "integer",
                                                                  "minimum":  0
                                                              },
                                                "rejectedRows":  {
                                                                     "type":  "integer",
                                                                     "minimum":  0
                                                                 },
                                                "rejectedShare":  {
                                                                      "type":  "number",
                                                                      "format":  "double"
                                                                  }
                                            }
                         },
    "DataQualitySourceDetail":  {
                                    "allOf":  [
                                                  {
                                                      "$ref": "./analytics-tenant.json#/DataQualitySource"
                                                  },
                                                  {
                                                      "type":  "object",
                                                      "required":  [
                                                                       "series",
                                                                       "recentBatches"
                                                                   ],
                                                      "properties":  {
                                                                         "series":  {
                                                                                        "type":  "array",
                                                                                        "items":  {
                                                                                                      "$ref": "./analytics-tenant.json#/DataQualityPoint"
                                                                                                  }
                                                                                    },
                                                                         "recentBatches":  {
                                                                                               "type":  "array",
                                                                                               "items":  {
                                                                                                             "$ref": "./imports.json#/ImportBatch"
                                                                                                         }
                                                                                           }
                                                                     }
                                                  }
                                              ]
                                }
}