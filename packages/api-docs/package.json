{
  "name": "@ucrp/api-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "redocly bundle ../openapi/openapi.yaml --output dist/openapi.yaml --ext yaml && node scripts/copy-ui.mjs",
    "docs": "bun run build && serve dist -l 8080",
    "bundle:json": "redocly bundle ../openapi/openapi.yaml --output dist/openapi.json --ext json",
    "lint": "redocly lint ../openapi/openapi.yaml"
  },
  "dependencies": {
    "swagger-ui-dist": "^5.34.1"
  },
  "devDependencies": {
    "@redocly/cli": "^2.0.0",
    "serve": "^14.2.4"
  }
}
