{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [".env", ".env.*"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "passThroughEnv": ["PATH", "HOME", "GO*", "CGO_*", "UCRP_*", "VITE_*"],
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"],
      "env": ["NODE_ENV", "VITE_*"],
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig*.json"],
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
    },
    "format": {
      "cache": false,
    },
    "clean": {
      "cache": false,
    },
    "docs": {
      "cache": false,
      "persistent": true,
    },
  },
}
